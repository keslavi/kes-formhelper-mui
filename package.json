{
  "name": "kes-react-formhelper",
  "version": "0.1.6",
  "description": "Form helper components for MUI built on react-hook-form.",
  "scripts": {
    "start": "node ./scripts/start.mjs",
    "dev": "vite",
    "kill-ports": "node scripts/kill-dev-ports.mjs 5100 5200 5300",
    "build": "npm run build:lib && npm run storybook-build",
    "build:lib": "tsc -p tsconfig.app.json --noEmit && vite build",
    "deploy:seed": "npm run build && node ./scripts/formhelper-deploy.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "node scripts/kill-dev-ports.mjs 5200 && storybook dev -p 5200 --exact-port --host 127.0.0.1",
    "storybook-build": "storybook build",
    "storybook-deploy": "npm run storybook-build && node ./scripts/storybook-deploy.js",
    "prepublishOnly": "npm run build",
    "stage-package-dist": "node ./scripts/stage-package-dist.mjs",
    "prepare": "husky",
    "test": "node scripts/kill-dev-ports.mjs 5300 && vitest --ui --watch --config vitest.unit.config.js --api.port 5300 --api.strictPort",
    "test-once": "vitest run --config vitest.unit.config.js"
  },  
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keslavi/kes-formhelper-mui.git"
  },
  "bugs": {
    "url": "https://github.com/keslavi/kes-formhelper-mui/issues"
  },
  "homepage": "https://github.com/keslavi/kes-formhelper-mui#readme",
  "type": "module",
  "main": "dist/formhelper-mui.cjs",
  "module": "dist/formhelper-mui.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/formhelper-mui.js",
      "require": "./dist/formhelper-mui.cjs"
    },
    "./storybook-embed": {
      "types": "./dist/storybook-embed.d.ts",
      "import": "./dist/storybook-embed.js",
      "require": "./dist/storybook-embed.cjs"
    }
  },
  "files": [
    "dist",
    "storybook-static",
    "src/stories"
  ],
  "keywords": [
    "react",
    "mui",
    "form",
    "react-hook-form",
    "components"
  ],

  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7",
    "zustand": ">=4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@hookform/resolvers": "^7.0.5",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-onboarding": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/lodash": "^4.17.27",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "storybook": "^10.6.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "yup": "^1.7.1",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "lodash": "^4.18.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
